/** What `openUrl` did. */
export interface OpenUrlResult {
  /** Whether an app opened the URL (`false` when none handles it). */
  opened: boolean;
}
/** Opens `url` outside the app: a web page in the browser, a `mailto:` link in the mail app, a `tel:` link in the phone app, any scheme another app registered. The embedding app may take it first and route it its own way. Resolves with `{ opened }`: whether it opened (`false` when no app handles it). Rejects with a `TypeError` for a URL it never opens (not absolute, `javascript:`, `data:`, `file:`, ...), and with `ERR_ACCESS_DENIED` when the `openUrl` capability does not grant its scheme. */
export declare function openUrl(url: string): Promise<OpenUrlResult>;
### .nsh/types/nsh/test.d.ts
  /** The URLs the app opened (`openUrl` of `nsh/device`, a `TextView`'s links), in order: recorded, never opened, and reported opened to the app. */
