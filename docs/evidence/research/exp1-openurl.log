## App.tsx
import { mount, openUrl, signal, Text, View } from "nsh";

function App() {
  const status = signal("idle");
  return (
    <View class="flex-1 items-center justify-center gap-4 bg-background">
      <Text class="text-3xl font-semibold text-foreground">{status()}</Text>
      <View
        onPress={async () => {
          const result = await openUrl("https://example.com/");
          status.update(() => (result.opened ? "opened" : "not-opened"));
        }}
        role="button"
        class="rounded-(--radius) bg-primary px-5 py-3 active:bg-primary/90"
      >
        <Text class="text-lg text-primary-foreground">Sign in</Text>
      </View>
    </View>
  );
}

mount(App);
## App.test.tsx
// Research probe: does headless nsh record openUrl without opening anything?
import { expect, open, test } from "nsh/test";

test("openUrl is recorded, not opened", async () => {
  const app = await open("./App.tsx");
  await app.press("role:button[Sign in]");
  await app.waitFor("opened");
  expect(app.openedUrls()).toEqual(["https://example.com/"]);
});

