<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The nsh AAR also declares INTERNET; the app declares its own too. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.NshAuthSandbox"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <!-- facebook-login 19.0.1 needs both entries to initialize (values are
             our obviously-fake sandbox ids). Missing entries do not crash: the
             SDK's FacebookInitProvider catches the failure and logs at INFO,
             so every SDK call then fails at use time instead. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="1234567890123456" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="nsh-auth-sandbox-client-token" />

        <!-- The Google web client id Credential Manager requests the id_token
             for (its aud). Host-owned key: neither credentials 1.6.0 nor
             googleid 1.2.1 defines one, and NativeSignInModule rejects google
             sign-in when it is absent. The sandbox value is fake on purpose. -->
        <meta-data
            android:name="nsh.auth.server-client-id"
            android:value="nsh-auth-sandbox-web.apps.googleusercontent.com" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The custom scheme redirect: providers return to nsh.auth.sandbox://callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nsh.auth.sandbox"
                    android:host="callback" />
            </intent-filter>
        </activity>
    </application>

    <!-- Android 11+ package visibility: without these queries BrowserSelector's
         enumeration (queryIntentActivities/resolveActivity) sees no browsers and
         resolveService/bindCustomTabsService cannot reach the warm-up service,
         so browser selection always reports "no browser". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
