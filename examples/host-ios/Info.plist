<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>nsh-auth sandbox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.nshauth.sandbox</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nsh.auth.sandbox</string>
			</array>
		</dict>
		<!-- The GoogleSignIn SDK requires the reversed client id as a scheme. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.googleusercontent.apps.nsh-auth-sandbox</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.nsh-auth-sandbox</string>
			</array>
		</dict>
		<!-- Facebook Login's OAuth callback scheme: "fb" + FacebookAppID. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.nshauth.sandbox.facebook</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb1234567890123456</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Sandbox fake ids (docs/research/native-sdks.md): the SDK flows are
	     expected to error at the provider's own surface, which is the pass. -->
	<key>FacebookAppID</key>
	<string>1234567890123456</string>
	<key>FacebookClientToken</key>
	<string>nsh-auth-sandbox-client-token</string>
	<key>FacebookDisplayName</key>
	<string>nsh-auth sandbox</string>
	<key>GIDClientID</key>
	<string>nsh-auth-sandbox.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>nsh-auth-sandbox-web.apps.googleusercontent.com</string>
	<!-- Only the app-switch schemes the Facebook SDK may query. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The mock OAuth server is plain http on loopback/local network. -->
	<!-- Scene lifecycle is required for apps built with the iOS 26+ SDK. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
